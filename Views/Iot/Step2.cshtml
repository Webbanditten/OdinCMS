@model KeplerCMS.Controllers.IotController.IotForm
<form method="post" action="/iot/go">
    <input type="hidden" name="Sid" value="26" />
    <input type="hidden" name="Member" value="@(Model.Member ? "true" : "false")" />
    @Html.AntiForgeryToken()
    <partial name="_Head" model='(2, Html.IotText(Model.Member ? "step2_title_member" : "step2_title_guest"))' />
    <partial name="_Error" model="Model.Error" />
    <table border="0" cellspacing="0" cellpadding="0" class="content-table">
        <tbody>
            <tr>
                <td valign="top">
                    <table border="0">
                        <tbody>
                            @if (Model.Member)
                            {
                                <tr><td valign="center"><b>@Html.IotText("step2_name")</b></td><td><input type="text" name="Name" size="30" maxlength="50" value="@Model.Name" /></td></tr>
                            }
                            <tr><td valign="center"><b>@Html.IotText("step2_email")</b></td><td><input type="text" name="Email" size="30" maxlength="255" value="@Model.Email" /></td></tr>
                        </tbody>
                    </table>
                    <p>@Html.IotText("step2_note")</p>
                </td>
                <td class="iactiontd" align="center"><partial name="_Button" model='Html.IotPlain("button_next")' /></td>
            </tr>
        </tbody>
    </table>
</form>
