@model KeplerCMS.Controllers.IotController.IotForm
<form method="post" action="/iot/go">
    <input type="hidden" name="Sid" value="76" />
    <partial name="_Carry" model="Model" />
    <partial name="_Head" model='(3, Html.IotText("step3_title"))' />
    <partial name="_Error" model="Model.Error" />
    <p>@Html.IotText("step3_intro")</p>
    <table border="0" cellspacing="0" cellpadding="0" class="content-table">
        <tbody>
            <tr>
                <td valign="top">
                    <select name="Issue">
                        <option value="">@Html.IotPlain("step3_choose")</option>
                        @foreach (var (key, _) in KeplerCMS.Data.Models.HelpTickets.Issues)
                        {
                            <option value="@key" selected="@(Model.Issue == key)">@Html.IotPlain("issue_" + key)</option>
                        }
                    </select>
                </td>
                <td class="iactiontd" align="center"><partial name="_Button" model='Html.IotPlain("button_next")' /></td>
            </tr>
        </tbody>
    </table>
</form>
