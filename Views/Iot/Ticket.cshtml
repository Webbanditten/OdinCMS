@model KeplerCMS.Controllers.IotController.TicketPage
@{
    ViewData["noFaq"] = true;
    var t = Model.Ticket;
    var you = t.Name ?? Html.IotPlain("ticket_you");
}
<partial name="_Head" model='(t.Status == KeplerCMS.Data.Models.HelpTickets.Closed ? 5 : 4, Html.IotText("ticket_title"))' />
@if (Model.Sent)
{
    <p style="color: #2a7d2a; font-weight: bold;">@Html.IotText("ticket_sent")</p>
}
<partial name="_Error" model="Model.Error" />
<p><b>@Html.IotPlain("issue_" + t.Issue, t.Issue)</b> · @t.CreatedAt.ToString("d. MMM yyyy HH:mm") · @Html.IotPlain("status_" + t.Status, t.Status.ToString())</p>
<div class="iot-message"><b>@you</b><br />@t.Message</div>
@foreach (var r in Model.Responses)
{
    <div class="iot-message @(r.StaffId != null ? "iot-staff" : "")"><b>@(r.StaffId != null ? Html.IotPlain("ticket_staff") : you)</b> · @r.CreatedAt.ToString("d. MMM yyyy HH:mm")<br />@r.Message</div>
}
@if (t.Status != KeplerCMS.Data.Models.HelpTickets.Closed)
{
    <form method="post" action="/iot/ticket">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@t.Id" />
        <input type="hidden" name="token" value="@t.Token" />
        <p><b>@Html.IotText("ticket_write")</b></p>
        <textarea name="message" class="imessageform" rows="6" cols="70" maxlength="4000"></textarea>
        <div style="float: right;"><partial name="_Button" model='Html.IotPlain("button_send")' /></div>
        <div style="clear: both;"></div>
    </form>
}
else
{
    <p>@Html.IotText("ticket_closed")</p>
}
<style>
    div.iot-message { text-align: left; white-space: pre-wrap; border: 1px solid #ddd; background: #f7f7f7; padding: 6px 8px; margin: 6px 0; }
    div.iot-message.iot-staff { background: #eef6fb; border-color: #b8d4e6; }
</style>
