@model KeplerCMS.Controllers.IotController.IotForm
@{
    ViewData["noFaq"] = true;
    // Prod terminates TLS upstream without forwarded headers, so Request.Scheme reads "http" there (as Client/Web.cshtml).
    var local = Context.Request.Host.Host is "localhost" or "127.0.0.1";
    var link = Model.Ticket == null ? null : $"{(local ? Context.Request.Scheme : "https")}://{Context.Request.Host}/iot/ticket?id={Model.Ticket.Id}&token={Model.Ticket.Token}";
}
<partial name="_Head" model='(5, Html.IotText("step5_title"))' />
<p>@Html.IotText("step5_text")@if (Model.Email != null) { <text> </text>@Html.IotText("step5_email", ("email", Model.Email)) }</p>
@if (link != null)
{
    <p>@Html.IotText("step5_link")</p>
    <p><a href="@link">@link</a></p>
}
@if (Html.IotHas("step5_note"))
{
    <p>@Html.IotText("step5_note")</p>
}
<p><a href="/">@Html.IotText("back")</a></p>
