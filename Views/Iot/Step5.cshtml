@model KeplerCMS.Controllers.IotController.IotForm
@{
    ViewData["Title"] = "Habbo Hjælpeværktøj";
    ViewData["noFaq"] = true;
    var link = Model.Ticket == null ? null : $"{Context.Request.Scheme}://{Context.Request.Host}/iot/ticket?id={Model.Ticket.Id}&token={Model.Ticket.Token}";
}
<partial name="_Head" model='(5, "Tak for din henvendelse!")' />
<p>Vi har modtaget din henvendelse og svarer, så snart vi kan.@(Model.Email != null ? " Vi skriver til " + Model.Email + ", når der er svar." : "")</p>
@if (link != null)
{
    <p>Her kan du se dit svar og skrive til os igen. Gem linket, det er kun til dig:</p>
    <p><a href="@link">@link</a></p>
}
<p><a href="/">Tilbage til Habbo</a></p>
