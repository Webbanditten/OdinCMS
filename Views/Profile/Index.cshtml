@using System.Text.RegularExpressions;
@model System.Collections.Generic.IEnumerable<KeplerCMS.Data.Models.Settings>;
@{
    
    ViewData["Title"] = @DbRes.T("my_data", "profile");
    var userData = (KeplerCMS.Data.Models.Users)ViewData["user"];
    var figureDataUrl = (userData.HasHabboClub) ? Url.Content("~/xml/figure_data_xml_hc.xml") : Url.Content("~/xml/figure_data_xml.xml");
    bool isOldFigure = new Regex(@"^\d+").IsMatch(userData.Figure);
    // Set by ProfileController after saving a tab: which tab to show and the message to show above it.
    var profileTab = TempData["profile_tab"] as string ?? Context.Request.Query["tab"].ToString();
    var profileOk = TempData["profile_ok"] as string;
    var profileError = TempData["profile_error"] as string;
}
@functions
{
    string L(string key, string set, string fallback)
    {
        var value = DbRes.T(key, set);
        return string.IsNullOrWhiteSpace(value) || value == key ? fallback : value;
    }
}

