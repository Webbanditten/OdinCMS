@model KeplerCMS.Controllers.ProfileController.ProfilePage
@using KeplerCMS.Helpers
@*
    "Min profil", laid out like habbo.com's 2006 profile page (jeanropke/Neptune's profile views): info boxes on the left,
    the process box with one tab per page in the middle (_Tab*.cshtml), "Din Habbo" on the right. ProfileController.
*@
@{
    ViewData["Title"] = Texts.T("my_data", "profile", "Min profil");
    var user = (KeplerCMS.Data.Models.Users)ViewData["user"];
    var ok = TempData["profile_ok"] as string;
    var error = TempData["profile_error"] as string;
    var heading = Texts.T("habbo_profile", "profile", "Habbo profil");
    heading = heading.Contains("{username}") ? heading.Replace("{username}", user.Username) : heading + " - " + user.Username;
    var tabs = new (string Key, string Url, string Label)[]
    {
        ("habbo", "/profile", Texts.T("tab_habbo", "profile", "Habbo")),
        ("mission", "/profile/mission", Texts.T("tab_mission", "profile", "Mission")),
        ("email", "/profile/email", Texts.T("tab_email", "profile", "Email")),
        ("password", "/profile/password", Texts.T("tab_password", "profile", "Adgangskode")),
        ("privacy", "/profile/privacy", Texts.T("tab_privacy", "profile", "Privatliv")),
    };
    var partial = "_Tab" + char.ToUpperInvariant(Model.Tab[0]) + Model.Tab.Substring(1);
}
@section Styles {
    <link href="~/styles/profile.css" asp-append-version="true" type="text/css" rel="stylesheet" />
}
<br />
<table border="0" cellpadding="0" cellspacing="0" width="100%">
    <tbody>
        <tr>
            <td style="width: 6px;">&nbsp;</td>
            <partial name="~/Views/Shared/Sidebars/Profile/left.cshtml" />
            <td valign="top" style="width: 446px; padding-top: 3px;" class="habboPage-col rightmost">
                <div class="processbox">
                    <div class="headline">
                        <div class="headline-content">
                            <div class="headline-wrapper">
                                <h2>@heading</h2>
                            </div>
                        </div>
                    </div>
                    <div class="content-top">
                        <div class="content">
                            @if (error != null)
                            {
                                <div class="content-red"><div class="content-red-body">@error<div class="clear"></div></div></div>
                                <div class="content-red-bottom"><div class="content-red-bottom-body"></div></div>
                            }
                            @if (ok != null)
                            {
                                <div class="content-ok"><div class="content-ok-body">@ok<div class="clear"></div></div></div>
                                <div class="content-ok-bottom"><div class="content-ok-bottom-body"></div></div>
                            }
                            <div id="profiletabs">
                                <ul>
                                    @for (var i = 0; i < tabs.Length; i++)
                                    {
                                        <li id="@(tabs[i].Key == Model.Tab ? "selected" : null)"><a href="@tabs[i].Url" class="@(i == tabs.Length - 1 ? "last-tab" : null)">@tabs[i].Label.ToUpper()</a></li>
                                    }
                                </ul>
                            </div>
                            <br clear="all" />
                            <div class="content-white-outer">
                                <div class="content-white">
                                    <div class="content-white-body">
                                        <div class="content-white-content profile-tab">
                                            <partial name="@partial" model="Model" />
                                        </div>
                                        <div class="clear"></div>
                                    </div>
                                </div>
                                <div class="content-white-bottom">
                                    <div class="content-white-bottom-body"></div>
                                </div>
                            </div>
                            <div class="clear"></div>
                        </div>
                    </div>
                    <div class="content-bottom">
                        <div class="content-bottom-content"></div>
                    </div>
                </div>
            </td>
            <td style="width: 3px;">&nbsp;</td>
            <partial name="~/Views/Shared/Sidebars/Profile/right.cshtml" />
            <td style="width: 6px;">&nbsp;</td>
        </tr>
    </tbody>
</table>

@section Scripts {
    <script src="~/js/myhabbo/visual.js" type="text/javascript"></script>
    <script src="~/js/settings.js" type="text/javascript"></script>
    <script>
        HabboView.run();
    </script>
}
