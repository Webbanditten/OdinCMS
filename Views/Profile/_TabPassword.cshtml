@model KeplerCMS.Controllers.ProfileController.ProfilePage
@using KeplerCMS.Helpers
<form method="post" action="/profile/updatepassword" autocomplete="off">
    <h3>@Texts.T("password_title", "profile", "Skift adgangskode")</h3>
    <h3>@Texts.T("password_current_title", "profile", "Din nuværende adgangskode")</h3>
    <div class="profile-field">
        <label for="password-current">@Texts.T("password_current", "profile", "Nuværende adgangskode:")</label><br />
        <input type="password" name="currentPassword" id="password-current" class="profile-text" size="32" maxlength="32" autocomplete="current-password" />
    </div>
    <h3>@Texts.T("password_new_title", "profile", "Vælg en ny adgangskode")</h3>
    <div class="profile-field">
        <label for="password-new">@Texts.T("password_new", "profile", "Ny adgangskode (mindst 6 tegn):")</label><br />
        <input type="password" name="newPassword" id="password-new" class="profile-text" size="32" maxlength="32" autocomplete="new-password" />
    </div>
    <div class="profile-field">
        <label for="password-repeat">@Texts.T("password_repeat", "profile", "Gentag ny adgangskode:")</label><br />
        <input type="password" name="retypePassword" id="password-repeat" class="profile-text" size="32" maxlength="32" autocomplete="new-password" />
    </div>
    <div id="register-buttons">
        <div id="register-buttons-continue"><input type="submit" value="@Texts.T("password_button", "profile", "Skift adgangskode")" class="process-button" /></div>
    </div>
    <div class="clear"></div>
</form>
