@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    Layout = null;
    var cms = Configuration.GetSection("keplercms");
    var web = cms.GetSection("webclient");
    var baseUrl = Context.Request.Host;
    // Prod terminates TLS upstream without forwarded headers, so Request.Scheme reads "http" there:
    // keep https for real hosts and only use the request scheme for local development (as Index.cshtml).
    var isLocalHost = baseUrl.Host == "localhost" || baseUrl.Host == "127.0.0.1";
    var scheme = isLocalHost ? Context.Request.Scheme : "https";
    var url = $"{scheme}://{baseUrl}";

    // The web client can use its own copies of the client files (local dev routes them through a CORS proxy);
    // by default it uses the same ones as the Shockwave client.
    string Pick(string key) => string.IsNullOrEmpty(web[key]) ? cms[key] : web[key];
    var dcr = Pick("dcr");
    var vars = Pick("vars");
    var texts = Pick("texts");

    var host = cms["host"];
    var port = int.TryParse(cms["port"], out var p) ? p : 0;
    var musPort = int.TryParse(cms["musport"], out var mp) ? mp : 0;
    var gameSocket = web["gameSocket"];
    var musSocket = string.IsNullOrEmpty(web["musSocket"]) ? gameSocket.Replace("/game", "/mus") : web["musSocket"];

    var forward = (int)ViewData["roomId"] != 0 && (int)ViewData["forwardId"] != 0
        ? $"forward.type={ViewData["forwardId"]};forward.id={ViewData["roomId"]}"
        : null;

    // ?large=1: habbo.dcr's prepareMovie doubles the stage to 1440x1080 when the embed has
    // dynamicResolution=1 and the screen is at least that big. The toggle link keeps the room forward.
    // The link is only shown when keplercms:webclient:largeClient is true (off while 2x still has
    // rendering and hit-detection issues); ?large=1 keeps working for testing.
    var large = Context.Request.Query["large"] == "1";
    var offerLarge = string.Equals(web["largeClient"], "true", StringComparison.OrdinalIgnoreCase);
    string ClientUrl(bool big)
    {
        var query = new List<string>();
        if ((int)ViewData["forwardId"] != 0) query.Add($"forwardId={ViewData["forwardId"]}");
        if ((int)ViewData["roomId"] != 0) query.Add($"roomId={ViewData["roomId"]}");
        if (big) query.Add("large=1");
        return "/client/web" + (query.Count > 0 ? "?" + string.Join("&", query) : "");
    }
}
<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="content-type" content="text/html;charset=utf-8" />
    <title>Habbo ~ Client</title>
    <link href='~/styles/style.css' type='text/css' rel='stylesheet' />
    <style>
        body#client { margin: 0; }
        #webclient-loading { color: #fff; font: 11px Verdana, Arial, sans-serif; padding: 8px; }
        @* Auto margins, not justify-content: center. A centred flex item wider than the window (the 1440 px large
           client) overflows on both sides, and the left overflow can't be scrolled to. Auto margins collapse to
           zero instead, so the client starts at the left edge and the page scrolls right. *@
        #client-stage { display: flex; }
        #client-stage > * { margin-left: auto; margin-right: auto; }
        #client-topbar .logout a.webclient-size { text-transform: none; padding-right: 10px; }
    </style>

    @* No Prototype here on purpose: it replaces native Array methods and Array.prototype.toJSON, which breaks
       DirPlayer's bundle. The few helpers the Shockwave page takes from habbo.js are inlined below. *@
    <script type="text/javascript">
        var habboClient = true;
        var habboReqPath = window.location.protocol.replace(/:/g, '') + '://@baseUrl';
        document.habboLoggedIn = true;
        // The site names its tab 'habboMain' (_Layout), and the name stays when the client opens in the
        // same tab. The client opens links in 'habboMain' (default.url.open.target), so it navigated itself
        // away (Messenger links, Habbo Home). Renamed, links open in a separate 'habboMain' tab again.
        if (window.name === 'habboMain') { window.name = 'habboClient'; }

        (function () {
            try {
                if (window.opener != null) {
                    if (window.opener.document.logoutPage != null && window.opener.document.logoutPage == true) {
                        window.opener.location.href = "/";
                    } else if (window.opener.document.habboLoggedIn != null && window.opener.document.habboLoggedIn == false) {
                        window.opener.location.reload();
                    }
                }
            } catch (error) { }
        })();

        window.addEventListener('unload', function () {
            try { if (window.opener && window.opener.openedHabbo) { window.opener.openedHabbo = null; } } catch (e) { }
        });

        // DirPlayer reports Lingo script errors with alert(), which would block the game. Log them instead.
        window.alert = function (message) { console.error('[DirPlayer]', message); };
    </script>

    <script src='@web["polyfill"]' data-manual-init onerror="window.dirplayerFailed = true"></script>
    <script type="text/javascript">
        if (window.DirPlayer) DirPlayer.configureFlash({
            disableFlash: true,
            // The client is told to connect to host:port over TCP (sw2/sw4); map both to Odin's WebSocket listener.
            socketProxy: [
                { host: @Json.Serialize(host), port: @port, proxyUrl: @Json.Serialize(gameSocket) },
                { host: @Json.Serialize(host), port: @musPort, proxyUrl: @Json.Serialize(musSocket) }
            ]
        });
        // The site opens the client in a popup (habbo.js _openHabboWindow), and a script-opened window may be
        // resized. Fit it to the client, so switching between the normal and the large client ("Stor klient")
        // needs no manual resize. In a normal tab browsers ignore resizeBy/moveTo, so this does nothing there.
        function fitWindowToClient(topbar) {
            try {
                var w = Math.min(@(large ? 1440 : 720), screen.availWidth);
                var h = Math.min(@(large ? 1080 : 540) + (topbar ? topbar.offsetHeight : 0), screen.availHeight);
                var dw = w - window.innerWidth, dh = h - window.innerHeight;
                if (dw !== 0 || dh !== 0) { window.resizeBy(dw, dh); }
                // Keep the resized window on the screen.
                var left = screen.availLeft || 0, top = screen.availTop || 0;
                var x = Math.max(left, Math.min(window.screenX, left + screen.availWidth - window.outerWidth));
                var y = Math.max(top, Math.min(window.screenY, top + screen.availHeight - window.outerHeight));
                if (x !== window.screenX || y !== window.screenY) { window.moveTo(x, y); }
            } catch (e) { }
        }
        window.addEventListener('DOMContentLoaded', function () {
            var topbar = document.getElementById('client-topbar');
            if (topbar && screen.height > 600) { topbar.style.display = 'block'; }
            // The client only goes 2x when the screen fits 1440x1080, so don't offer it otherwise.
            var bigLink = document.getElementById('webclient-large');
            if (bigLink && (screen.width < 1440 || screen.height < 1080)) { bigLink.style.display = 'none'; }
            fitWindowToClient(topbar);
            // Without WebAssembly (an old browser), or when DirPlayer didn't load, say so instead of a black screen.
            var unavailable = function () {
                document.getElementById('client-stage').style.display = 'none';
                document.getElementById('client-unavailable').className = 'is-shown';
            };
            if (typeof WebAssembly !== 'object' || !window.DirPlayer || window.dirplayerFailed) { unavailable(); return; }
            try { DirPlayer.init(); } catch (e) { console.error('[DirPlayer]', e); unavailable(); }
        });
    </script>
    <script src='~/js/jquery.min.js' asp-append-version="true"></script>
    <script type='text/javascript'>
        var j = jQuery.noConflict();
        j(function () {
            function refreshOnlineCount() {
                j.get(habboReqPath + '/api/hotel/online').done(function (msg) { j('.online-count').text(msg); });
            }
            refreshOnlineCount();
            setInterval(refreshOnlineCount, 60000);
        });
    </script>
</head>
<body id="client">
    <div id="client-topbar" style="display:none">
        <div class="logo"><img src="~/images/popup/popup_topbar_habbologo.gif" alt="" align="middle" /></div>
        <div class="habbocount">
            <div id="habboCountUpdateTarget">
                <span class="online-count"></span> @DbRes.T("online_on_habbo", "shared")
            </div>
        </div>
        <div class="logout">
            @if (large)
            {
                <a class="webclient-size" href="@ClientUrl(false)">Normal klient</a>
            }
            else if (offerLarge)
            {
                <a class="webclient-size" id="webclient-large" href="@ClientUrl(true)">Stor klient</a>
            }
            <a href="/account/logout?origin=popup">@DbRes.T("signoff", "topbar")</a>
        </div>
    </div>
    <partial name="_ClientUnavailable" model='"webclient_unsupported"' />
    <div id="client-stage">
        <embed src='@dcr' bgColor='#000000' width='@(large ? 1440 : 720)' height='@(large ? 1080 : 540)' type='application/x-director'
               swStretchStyle='none' swText=''
               sw1='site.url=@url;url.prefix=@url'
               sw2='connection.info.host=@host;connection.info.port=@port'
               sw3='client.reload.url=@url@ClientUrl(large);client.allow.cross.domain=1;client.notify.cross.domain=0'
               sw4='connection.mus.host=@host;connection.mus.port=@musPort'
               sw5='external.variables.txt=@vars;external.texts.txt=@texts'
               sw6='use.sso.ticket=1;sso.ticket=@ViewData["sso"]'
               sw7='@forward'
               @* Legacy downloaded-client check: Odin sends an "outdated version" popup when this is lower than
                  the client.version setting, and external_vars has no client.version.id, so the web client sent 0.
                  swN values are set as variables after external_vars loads. *@
               sw8='client.version.id=9999'
               dynamicResolution='@(large ? "1" : null)' />
    </div>
</body>
</html>
