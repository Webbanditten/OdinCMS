@model ErrorViewModel
@{
    // Standalone on purpose: the shared layout hits the DB and filters, which may be what failed.
    Layout = null;
}
<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Habbo ~ Fejl</title>
    <style>
        body { margin: 0; background: #1e3d4f; font: 13px Verdana, Arial, sans-serif; color: #000; }
        .box { max-width: 420px; margin: 80px auto; background: #fff; border: 2px solid #000; border-radius: 6px; }
        .box h1 { margin: 0; padding: 6px 10px; background: #e2621d; color: #fff; font-size: 13px; border-bottom: 2px solid #000; }
        .box div { padding: 12px 14px; line-height: 1.5; }
        .box a { color: #e2621d; font-weight: bold; }
        .box code { font-size: 11px; color: #666; }
    </style>
</head>
<body>
    <div class="box">
        <h1>Ups! Der skete en fejl</h1>
        <div>
            <p>Noget gik galt, mens vi behandlede din forespørgsel. Prøv igen om lidt.</p>
            <p><a href="/">Tilbage til forsiden</a></p>
            @if (Model?.ShowRequestId == true)
            {
                <p><code>Fejl-ID: @Model.RequestId</code></p>
            }
        </div>
    </div>
</body>
</html>
