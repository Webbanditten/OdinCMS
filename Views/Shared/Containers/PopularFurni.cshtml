@using KeplerCMS.Data.Models
@model Containers
@inject KeplerCMS.Services.Interfaces.IFurniService FurniService

@{
    var furni = await FurniService.GetPopularFurni();
    if(furni == null)
    {
        // Nothing bought in the last 30 days (or purchase_log is new): say so instead of an empty box.
        var none = DbRes.T("purchase_none", "containers");
        <p>@(string.IsNullOrWhiteSpace(none) || none == "purchase_none" ? "Ingen har købt møbler i kataloget den sidste måned." : none)</p>
        return;
    }
    <div class="popular_furni">
    <strong>
        @furni.Name
    </strong><br />
        <img src="@Url.Content("~/habbo-imaging/furni")?direction=2&@KeplerCMS.Helpers.FurniPicture.Query(furni.ImageSprite ?? furni.Sprite)"/><br />
        @DbRes.T("containers", "purchase_count").Replace("{amount}", @furni.Amount.ToString())
    </div>
}
