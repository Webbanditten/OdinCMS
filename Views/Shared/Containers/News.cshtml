@model KeplerCMS.Models.Page
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@functions
{
    // A link into the hotel (/client, with or without a room to go to) opens or focuses the client's pop-up window,
    // like "Gå til hotellet" in the top bar. Anything else is a plain link.
    static readonly System.Text.RegularExpressions.Regex ClientPath = new(@"^/?client(/web)?/?([?#]|$)",
        System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant);

    bool IsClientLink(string href)
    {
        if (string.IsNullOrWhiteSpace(href)) { return false; }
        var path = href.Trim();
        // a full address of this site counts too
        var own = System.Text.RegularExpressions.Regex.Match(path, @"^https?://([^/?#:]+)(:\d+)?", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (own.Success)
        {
            if (!string.Equals(own.Groups[1].Value, Context.Request.Host.Host, StringComparison.OrdinalIgnoreCase)) { return false; }
            path = path.Substring(own.Length);
            if (path.Length == 0) { return false; }
        }
        return ClientPath.IsMatch(path);
    }

    // `inner` is markup: a link's text as staff wrote it, or the promo's picture.
    string LinkHtml(string href, string inner)
    {
        var a = "<a href=\"" + System.Net.WebUtility.HtmlEncode(href ?? "") + "\"";
        if (IsClientLink(href)) { a += " target=\"client\" onclick=\"openOrFocusHabbo(this); return false;\""; }
        return a + ">" + inner + "</a>";
    }

    // The picture goes where the promo's first link goes, and opens the hotel the same way that link does.
    string ImageHtml(KeplerCMS.Data.Models.Promo promo)
    {
        var img = "<img src=\"" + System.Net.WebUtility.HtmlEncode(promo.Img ?? "") + "\" alt=\"\">";
        return string.IsNullOrWhiteSpace(promo.Link1Href) ? img : LinkHtml(promo.Link1Href, img);
    }

    string[] LinksHtml(KeplerCMS.Data.Models.Promo promo)
    {
        var links = new List<string>();
        if (!string.IsNullOrEmpty(promo.Link1Text)) { links.Add(LinkHtml(promo.Link1Href, promo.Link1Text)); }
        if (!string.IsNullOrEmpty(promo.Link2Text)) { links.Add(LinkHtml(promo.Link2Href, promo.Link2Text)); }
        return links.ToArray();
    }
}
@{
    var promos = Model.Promos.Where(s => s.Hidden == false && s.IsScheduledVisible).OrderBy(s => s.Order).ToList();
}
<tr>
    <td colspan="3" style="padding-bottom: 3px;">

        <div id="promoarea"@if (ViewData["cmsEdit"] as bool? == true) {<text> data-cms-page="@Model.Details.Id" data-cms-promos="@string.Join(",", promos.Select(p => p.Id))"</text>}>
            <!-- NEWS ITEMS INCLUDE -->

            <script type="text/javascript">
            // What showPromo() (js/habbo.js) puts in the page for each promo: the same markup as the first one below.
            var promoPages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(promos.Select(p => new { image = ImageHtml(p), links = LinksHtml(p), text = p.Teaser ?? "" })));
            </script>

            <div id="promoheader">
                <h2>@Model.Details.NewsHeader</h2>
                <ul style="display: block;" id="promoheader-selectors">
                    @{
                        if (promos.Count() > 1)
                        {
                            for (var i = 0; i < promos.Count(); i++)
                            {
                                var selected = (i == 0) ? "class=selected" : "";
                                <li><a href="#" onclick="showPromo(@i); return false;" @selected>@(i+1)</a></li>
                            }
                        }

                    }

                </ul>
            </div>

            <div id="promocontent">
                @{
                    if (promos.Any())
                    {
                        <div id="promobody">
                            <p id="promoimage">@Html.Raw(ImageHtml(promos[0]))</p>
                            <div class="promotext">
                                <p id="promotext-content">@Html.Raw(@promos[0].Teaser)</p>
                            </div>
                            <div id="promolinks">
                                <ul id="promolinks-list">
                                    @foreach (var link in LinksHtml(promos[0]))
                                    {
                                        <li>@Html.Raw(link)</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                }
            </div>

        </div>
        <div id="newsbox">
            <div id="newsbox-header">
                <h2>@DbRes.T("news_header", "news")</h2>
            </div>
            <div id="newsbox-text">
                @{
                    if (Model.News != null)
                    {

                        foreach (var news in Model.News.OrderByDescending(s=>s.PublishDate).Take(3))
                        {
                            <div class="newsitem oldnewsitem">
                                <h3>
                                    <span class="articledate">[@news.PublishDate.ToString(Configuration.GetSection("keplercms")["shortDateFormat"])]</span>
                                    <a href="/news/@news.Slug">@news.Title</a>
                                </h3>
                                <p>
                                    @news.Teaser
                                </p>
                            </div>
                        }
                        if (Model.News.Count() > 3)
                        {
                            <div class="hr">&nbsp;</div>
                            foreach (var news in Model.News.OrderByDescending(s=>s.PublishDate).Skip(3).Take(2))
                            {
                                <div class="newsitem oldnewsitem">
                                    <h3>
                                        <span class="articledate">[@news.PublishDate.ToString(Configuration.GetSection("keplercms")["shortDateFormat"])]</span>
                                        <a href="/news/@news.Slug">@news.Title</a>
                                    </h3>
                                </div>
                            }
                        }
                    }
                }
            </div>
            <div id="newsbox-footer">
                <div class="promo-button"><a href="/news">@DbRes.T("readmore", "news")</a></div>
            </div>
        </div>


    </td>
</tr>
