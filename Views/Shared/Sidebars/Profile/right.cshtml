@using Microsoft.Extensions.Configuration
@using KeplerCMS.Helpers
@inject IConfiguration Configuration
@* The profile page's right column: "Din Habbo" (habbo.com's 2006 profilebox: name, online, created, badge, figure, mission). *@
@{
    var user = (KeplerCMS.Data.Models.Users)ViewData["user"];
    var settings = Configuration.GetSection("keplercms");
}
<td valign="top" style="padding-top: 3px;">
    <div class="profilebox">
        <div class="profilebox-header">
            <h3>@Texts.T("info_profile_title", "profile", "Din Habbo")</h3>
        </div>
        <div class="profilebox-header-bottom">
            <div></div>
        </div>
        <div class="profilebox-body">
            <div class="profilebox-content">
                <div class="profile-info">
                    <div class="name">@user.Username</div>
                    @if (user.Status == "online")
                    {
                        <img alt="online" src="~/c_images/myhabbo/habbo_online_anim.gif" />
                    }
                    else
                    {
                        <img alt="offline" src="~/c_images/myhabbo/habbo_offline.gif" />
                    }
                    <div class="birthday text">@Texts.T("created_at", "profile", "Oprettet d.")</div>
                    <div class="birthday date">@user.CreateAt.ToString("dd-MM-yyyy")</div>
                    <div class="badges">
                        @if (user.IBadgeActive == 1 && !string.IsNullOrEmpty(user.Badge))
                        {
                            <img src="@settings["badgeUrl"]/@(user.Badge).gif" alt="@user.Badge" />
                        }
                    </div>
                </div>
                <div class="figure">
                    <img src="@settings["figureUrl"]?figure=@user.Figure&amp;action=std&amp;direction=4&amp;head_direction=3&amp;gesture=sml" alt="@user.Username" />
                </div>
                <div class="clear"></div>
                @if (!string.IsNullOrWhiteSpace(user.Motto))
                {
                    <div>
                        <div class="content-blue">
                            <div class="content-blue-body">
                                @user.Motto
                                <div class="clear"></div>
                            </div>
                        </div>
                        <div class="content-blue-bottom">
                            <div class="content-blue-bottom-body"></div>
                        </div>
                    </div>
                }
                <div class="clear"></div>
            </div>
        </div>
    </div>
</td>
