@model EndViewModel
@*
    After saving in the editor (its end_page_url): the movie is saved but not published yet. Publish it (POST
    /habbowood/publish), watch it first, or keep editing.
*@
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Habbowood";
    ViewData["hwoodTab"] = "shoot";
    var movie = Model.Movie;
}
@section Styles {
    <link rel="stylesheet" href="~/styles/habbowood.css" asp-append-version="true" />
}
<partial name="~/Views/Shared/Habbowood/_FilmStrip.cshtml" />
<div class="habbomovies-custom-bg">
    <table border="0" cellpadding="0" cellspacing="0" width="100%">
        <tbody>
            <tr>
                <td style="width: 4px;"></td>
                <td valign="top" style="width: 202px;">
                    <div class="portlet-goldenfilm goldenfilm">
                        <div class="portlet-goldenfilm-header"><h3>@HabbowoodText.T("end_mine_title", "Dine film")</h3></div>
                        <div class="portlet-goldenfilm-header-b"></div>
                        <div class="portlet-goldenfilm-body">
                            <div class="portlet-goldenfilm-content">
                                <p>@HabbowoodText.T("end_mine_text", "Alle dine film ligger under Mine film. Der kan du se dem, rette i dem, der ikke er udgivet endnu, og slette dem.")</p>
                                <p><img src="~/c_images/album2201/golden_star.gif" width="15" height="15" alt="" /> <a href="/habbowood/mine">@HabbowoodText.T("menu_mine", "Mine film")</a><br />
                                    <img src="~/c_images/album2201/golden_star.gif" width="15" height="15" alt="" /> <a href="/habbowood">@HabbowoodText.T("end_new", "Lav en ny film")</a></p>
                                <div class="clear"></div>
                            </div>
                        </div>
                        <div class="portlet-goldenfilm-bottom"><div class="portlet-goldenfilm-bottom-body"></div></div>
                    </div>
                </td>
                <td style="width: 4px;"></td>
                <td valign="top" style="width: 525px;">
                    <div class="portlet-film film">
                        <div class="portlet-film-header"><h3>@HabbowoodText.T("end_title", "Din film er gemt!")</h3></div>
                        <div class="portlet-film-header-b"></div>
                        <div class="portlet-film-body">
                            <div class="portlet-film-content">
                                <p><img src="~/c_images/album1644/unknown_4.gif" width="45" height="45" align="left" hspace="5" alt="" />
                                    <strong>@movie.Name</strong>@if (!string.IsNullOrWhiteSpace(Model.Subtitle)) {<br />@Model.Subtitle}</p>
                                <div class="clear"></div>
                                @if (movie.Published)
                                {
                                    <p>@HabbowoodText.T("end_published", "Filmen er udgivet, så alle kan se den og give den stjerner.")</p>
                                    <p><a href="/habbowood/watch/@movie.Id"><strong>@HabbowoodText.T("end_watch", "Se filmen")</strong></a></p>
                                }
                                else
                                {
                                    <p>@HabbowoodText.T("end_text", "Når du udgiver filmen, kan alle på Habbo se den og give den stjerner. Du kan ikke rette i den, når den er udgivet.")</p>
                                    <form method="post" action="/habbowood/publish">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="movieId" value="@movie.Id" />
                                        <input type="submit" class="submit" value="@HabbowoodText.T("end_publish", "Udgiv filmen")" />
                                    </form>
                                    <p class="hwood-actions">
                                        <a href="/habbowood/watch/@movie.Id">@HabbowoodText.T("end_preview", "Se den først")</a> |
                                        <a href="/habbowood?movie=@movie.Id">@HabbowoodText.T("end_edit", "Ret i filmen")</a>
                                    </p>
                                }
                                <div class="clear"></div>
                            </div>
                        </div>
                        <div class="portlet-film-bottom"><div class="portlet-film-bottom-body"></div></div>
                    </div>
                </td>
                <partial name="~/Views/Shared/Sidebars/Ad/ad.cshtml" />
            </tr>
        </tbody>
    </table>
</div>
<br style="clear: both;" />
