@model KeplerCMS.Areas.Housekeeping.PetsController.PetsPage
@{
    ViewBag.Title = "Find pets by user";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<h2>Find pets by user</h2>
<form method="get" action="@Url.Action("Index")">
    <select name="criteria">
        <option value="owner" selected="@(Model.Criteria == "owner")">Owner's Habbo name</option>
        <option value="name" selected="@(Model.Criteria == "name")">Pet's name contains</option>
    </select>
    <input type="text" name="query" value="@Model.Query" size="25" /> <button type="submit">Search</button>
</form>
@if (Model.Query != null)
{
    <p>@(Model.Pets.Count == 0 ? "No pets found." : Model.Pets.Count + (Model.Pets.Count == 1 ? " pet." : " pets."))</p>
    @if (Model.Pets.Count > 0)
    {
        <table class="habboTable" style="width: 100%;">
            <thead><tr><th>Name</th><th>Kind</th><th>Race</th><th>Colour</th><th>Born</th><th>Owner</th><th>Where</th></tr></thead>
            <tbody>
                @foreach (var p in Model.Pets)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td>@KeplerCMS.Areas.Housekeeping.PetsController.TypeName(p.Type)</td>
                        <td>@p.Race</td>
                        <td>@if (!string.IsNullOrEmpty(p.Colour)) {<span style="display: inline-block; width: 12px; height: 12px; background: #@p.Colour; border: 1px solid #999; vertical-align: middle;"></span> @p.Colour}</td>
                        <td style="white-space: nowrap;">@p.Born.ToString("yyyy-MM-dd", inv)</td>
                        <td>@if (p.Owner != null) {<a href="/housekeeping/users/manage/@p.OwnerId">@p.Owner</a>} else {<text>#@p.OwnerId</text>}</td>
                        <td>@if (p.RoomId > 0) {<a href="/housekeeping/rooms/view/@p.RoomId">@(p.RoomName ?? "Room #" + p.RoomId)</a>} else {<text>In the hand</text>}</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
