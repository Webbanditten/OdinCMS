@model KeplerCMS.Data.Models.Settings

<div class="card">
    <div class="card-header">
        <h4 class="text-uppercase">Update Setting</h4>
    </div>
    <div class="card-body">
        <form asp-action="Update">

            <div class="form-group">
                <label asp-for="Setting" class="label-control"></label>
                <input readonly asp-for="Setting" class="form-control" />
                <span asp-validation-for="Setting" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Value" class="label-control"></label>
                <input asp-for="Value" class="form-control" />
                <span asp-validation-for="Value" class="text-danger"></span>
                @{
                    // Image settings get the media library (site background, hotel banner).
                    var imageFolder = Model.Setting switch { "cms.background" => "site:images/bg_patterns", "cms.hotel_banner" => "site:c_images/hotelviews", _ => null };
                }
                @if (imageFolder != null)
                {
                    <img data-media-preview-for="Value" alt="" style="display: block; max-width: 100%; max-height: 100px; margin: 4px 0;" />
                    <button type="button" class="btn btn-sm btn-secondary" data-media-for="Value" data-media-category="@imageFolder">Choose image</button>
                }
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-sm btn-primary">Submit</button>
            </div>
        </form>
    </div>
</div>

@section scripts {
    <script src="~/housekeeping/js/media-library.js" asp-append-version="true"></script>
    <script src="~/housekeeping/js/media-fields.js" asp-append-version="true"></script>
}
