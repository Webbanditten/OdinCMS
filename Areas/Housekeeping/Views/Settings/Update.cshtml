@model KeplerCMS.Data.Models.Settings

<div class="card">
    <div class="card-header">
        <h4 class="text-uppercase">Update Setting</h4>
    </div>
    <div class="card-body">
        <form asp-action="Update">

            <div class="form-group">
                <label asp-for="Setting" class="label-control"></label>
                <input readonly asp-for="Setting" class="form-control" />
                <span asp-validation-for="Setting" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Value" class="label-control"></label>
                <input asp-for="Value" class="form-control" />
                <span asp-validation-for="Value" class="text-danger"></span>
                @{
                    // Image settings get the media library (site background, hotel banner).
                    var imageFolder = Model.Setting switch { "cms.background" => "site:images/bg_patterns", "cms.hotel_banner" => "site:c_images/hotelviews", _ => null };
                }
                @{
                    // What the game server's Habbo Club settings do (Odin, game/club/ClubSubscription.java).
                    var help = Model.Setting switch
                    {
                        "club.gold.months" => "Months as Habbo Club member before the gold HC badge. Only membership time counts, breaks don't. 12 = from the first day of the 13th month, as on Habbo. 0 = no gold badge. Applies straight away, also to players who are online.",
                        "club.gift.interval" => "How much membership time earns one Habbo Club gift, in the unit of club.gift.timeunit (Habbo: 31 days). Changing it only changes when the next gift comes.",
                        "club.gift.timeunit" => "The unit of club.gift.interval: DAYS, HOURS or MINUTES.",
                        "club.gift.present.label" => "The text on the Habbo Club gift present.",
                        "ads.url" => "The website address the in-game ads load from (Housekeeping > Ads), e.g. https://habbo-danmark.com. Empty: no ads in the hotel (the website's ads still show). Applies straight away.",
                        "ads.loading.every" => "The room loading ad (Housekeeping > Ads) is shown on every this many room entries, at most 5 times per visit to the hotel. 0 = never. Applies straight away.",
                        "ads.pool.every" => "The pool screen in Habbo Poolen II and on Tagterassen shows a pool screen ad (Housekeeping > Ads) every this many camera turns of 10 seconds (6 = once a minute). 0 = never. Applies straight away.",
                        "room.spectator.turn.minutes" => "Spectator turns in rooms with spectator seats (Housekeeping > Rooms): while others wait for a seat, a spectator who has watched this many minutes gets \"Nu er det en andens tur til at se eventet.\" and the seat goes to the next. 0 = off: spectators keep their seat. Applies straight away.",
                        _ => null
                    };
                }
                @if (help != null)
                {
                    <small class="form-text text-muted">@help</small>
                }
                @if (imageFolder != null)
                {
                    <img data-media-preview-for="Value" alt="" style="display: block; max-width: 100%; max-height: 100px; margin: 4px 0;" />
                    <button type="button" class="btn btn-sm btn-secondary" data-media-for="Value" data-media-category="@imageFolder">Choose image</button>
                }
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-sm btn-primary">Submit</button>
            </div>
        </form>
    </div>
</div>

@section scripts {
    <script src="~/housekeeping/js/media-library.js" asp-append-version="true"></script>
    <script src="~/housekeeping/js/media-fields.js" asp-append-version="true"></script>
}
