@model MenuAddViewModel

<div class="card">
    <div class="card-header">
        <h4 class="text-uppercase">Create Menu</h4>
    </div>
    <div class="card-body">
        <form asp-action="Create">
            <div class="form-group">
                <label asp-for="Text" class="label-control"></label>
                <input asp-for="Text" class="form-control" />
                <span asp-validation-for="Text" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Icon" class="label-control"></label>
                <select asp-for="Icon" class="form-control">
                    <option>spaceexplore_tab</option>
                    <option>tab_icon_01_home</option>
                    <option>tab_icon_02_hotel</option>
                    <option>tab_icon_03_community</option>
                    <option>tab_icon_04_games</option>
                    <option>tab_icon_05_bbs</option>
                    <option>tab_icon_05_fun</option>
                    <option>tab_icon_06_mobile</option>
                    <option>tab_icon_07_shop</option>
                    <option>tab_icon_08_help</option>
                    <option>tab_icon_09_hc</option>
                    <option>tab_icon_10_coins</option>
                    <option>tab_icon_11_bbs</option>
                    <option>Xmas_tab_image</option>
                </select>
                <span asp-validation-for="Icon" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Href" class="label-control"></label>
                <input asp-for="Href" class="form-control" />
                <span asp-validation-for="Href" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="State" class="label-control"></label>
                <select asp-for="State" class="form-control">
                    <option value="display">Display</option>
                    <option value="authenticated">Authentication required</option>
                </select>
                <span asp-validation-for="State" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="label-control">Schedule start (optional)</label>
                <input type="text" id="startDatepicker" name="StartDate" value="@(Model?.StartDate?.ToString("yyyy-MM-dd HH:mm:ss"))" class="form-control" placeholder="Leave blank for no start" autocomplete="off" />
                <small class="text-muted">When set, the item only shows from this time.</small>
            </div>
            <div class="form-group">
                <label class="label-control">Schedule end (optional)</label>
                <input type="text" id="endDatepicker" name="EndDate" value="@(Model?.EndDate?.ToString("yyyy-MM-dd HH:mm:ss"))" class="form-control" placeholder="Leave blank for no end" autocomplete="off" />
                <small class="text-muted">When set, the item stops showing after this time.</small>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-sm btn-primary">Submit</button>
            </div>
        </form>
    </div>
</div>

@section scripts {
    <link rel="stylesheet" href="~/lib/datetimepicker/jquery.datetimepicker.min.css">
    <script src="~/lib/datetimepicker/jquery.datetimepicker.full.js"></script>
    <script>
        $(document).ready(function () {
            var datetimeSettings = { format: 'Y-m-d H:i:s' };
            $("#startDatepicker").datetimepicker(datetimeSettings);
            $("#endDatepicker").datetimepicker(datetimeSettings);
        });
    </script>
}