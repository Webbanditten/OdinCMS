@{
    Layout = "_Housekeeping";
    ViewBag.Title = "Catalogue";
    ViewBag.WideContent = true;
}
<link rel="stylesheet" href="~/housekeeping/catalogue/catalogue.css" asp-append-version="true">

<h1>Catalogue</h1>

<div class="cated" id="cated">
    <div class="cated-preview">
        <div class="cated-preview-bar">
            <label class="cated-check"><input type="checkbox" id="cated-zoom"> 2x</label>
            <label class="cated-check"><input type="checkbox" id="cated-show-hidden" checked> Show hidden pages</label>
            <label class="cated-check" title="Draw the v31 catalogue (hh_cat_new) the web client can run instead of the Shockwave one"><input type="checkbox" id="cated-v31"> Web client (v31)</label>
            <span class="cated-note">As in the game. Click a text or image to edit it, a product to open it.</span>
        </div>
        <div class="cated-room"><div class="ctlg-stage" id="cated-stage"></div></div>
    </div>

    <div class="cated-panel">
        <div class="cated-toolbar">
            <span class="cated-status" id="cated-status">Loading…</span>
            <span class="cated-grow"></span>
            <button type="button" id="cated-new-page">+ New page</button>
            <button type="button" id="cated-new-folder" title="A folder in the v31 catalogue's tree">+ New folder</button>
            <button type="button" id="cated-new-furni">+ New furni</button>
            <button type="button" class="cated-primary" id="cated-publish" title="Make the hotel reload the catalogue from the database">Publish to the hotel</button>
        </div>
        <div class="cated-tabs" id="cated-tabs">
            <button type="button" data-tab="page" class="is-active">Page</button>
            <button type="button" data-tab="products">Products</button>
            <button type="button" data-tab="index">Index (all pages)</button>
        </div>
        <div id="cated-tab-page"></div>
        <div id="cated-tab-products" hidden></div>
        <div id="cated-tab-index" hidden></div>
    </div>
</div>

@section scripts {
    <script src="~/housekeeping/catalogue/catalogue-view.js" asp-append-version="true"></script>
    <script src="~/housekeeping/js/catalogue-editor.js" asp-append-version="true"></script>
    <script>
        CatalogueEditor.init({
            base: '@Url.Action("Index", "Catalogue")'.replace(/\/Index$/, ''),
            pageId: @(int.TryParse(Context.Request.Query["page"], out var pageId) ? pageId : 0)
        });
    </script>
}
