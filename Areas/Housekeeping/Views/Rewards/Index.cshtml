@{
    ViewBag.Title = "Rewards";
}
<h1>Rewards</h1>
<p class="rewards-intro">
    Players get a day's reward the next time they log in that day: a present with the furni (the note is the gift card),
    and/or a badge. Click a day to add or change a reward, or build a whole calendar.
</p>

<div class="rewards-toolbar">
    <button type="button" id="month-prev" title="Previous month">&laquo;</button>
    <strong id="month-title"></strong>
    <button type="button" id="month-next" title="Next month">&raquo;</button>
    <button type="button" id="month-today">Today</button>
    <span class="rewards-toolbar-links">
        <a class="rewards-button" href="@Url.Action("Builder")">New calendar</a>
        <a class="rewards-button" href="@Url.Action("Pools")">Furni pools</a>
    </span>
</div>

<div id="reward-month" class="reward-month"></div>

<div class="rewards-panels">
    <div class="rewards-panel">
        <h3>Copy a period</h3>
        <p>Repeats rewards with the same furni, badge, note and times, e.g. December 2025 as December 2026.</p>
        <div class="rewards-row">
            <label>From <input type="text" id="copy-from" class="rewards-date" autocomplete="off"></label>
            <label>To <input type="text" id="copy-to" class="rewards-date" autocomplete="off"></label>
        </div>
        <div class="rewards-row">
            <label>First day lands on <input type="text" id="copy-target" class="rewards-date" autocomplete="off"></label>
            <label>Label <input type="text" id="copy-label" placeholder="Keep the old label" autocomplete="off"></label>
        </div>
        <button type="button" id="copy-run">Copy</button>
    </div>
    <div class="rewards-panel">
        <h3>Remove a calendar</h3>
        <p>Deletes the calendar's rewards that haven't started yet. Started ones stay, with who got them.</p>
        <div class="rewards-row">
            <select id="delete-label"></select>
            <button type="button" id="delete-run">Delete upcoming</button>
        </div>
    </div>
</div>

@section scripts {
    <partial name="_RewardScripts" />
    <script>Rewards.initMonth();</script>
}
