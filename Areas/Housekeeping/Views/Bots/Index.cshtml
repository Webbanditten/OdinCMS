@model KeplerCMS.Areas.Housekeeping.Models.Views.BotsListView

@{
    ViewBag.Title = "Bots";
    ViewBag.WideContent = true;
}
<link rel="stylesheet" href="~/housekeeping/css/bots.css" asp-append-version="true">

<h1>@ViewBag.Title</h1>
<p>The public rooms' bots, drawn as the hotel draws them in their room (the room's own clothes, at the room's size). Open one to change its look, where it walks and what it says.</p>
@if (ViewBag.Message != null)
{
    <p class="bot-message">@ViewBag.Message</p>
}
<p><a class="btn btn-primary" href="@Url.Action("New")">Add a bot</a></p>

<div class="bot-rooms">
@foreach (var room in Model.Bots.GroupBy(b => b.Room))
{
    <div class="bot-room">
        <h3>@room.Key.Name <small>@room.Key.Casts</small> <a class="bot-add" href="@Url.Action("New", new { roomId = room.Key.Id })">+ bot here</a></h3>
        <div class="bot-cards">
            @foreach (var bot in room)
            {
                <a class="bot-card" href="@Url.Action("Edit", new { id = bot.Id })" title="Edit @bot.Name">
                    <span class="bot-thumb"><img src="@Url.Action("Picture", new { id = bot.Id })" alt="" loading="lazy" onload="this.style.width = (this.naturalWidth * 2) + 'px'"></span>
                    <span class="bot-name">@bot.Name</span>
                    <span class="bot-mission">@bot.Mission</span>
                </a>
            }
        </div>
    </div>
}
</div>
