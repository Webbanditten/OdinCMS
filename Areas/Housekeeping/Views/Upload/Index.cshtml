@model IEnumerable<KeplerCMS.Areas.Housekeeping.Models.Views.UploadViewModel>;

<h1>Uploads</h1>

@if (ViewData["message"] != null)
{
    <div class="message">
        @ViewData["message"]
    </div>
}
<a href="@Url.Action("Create")">Add</a> · <a href="#" id="open-media-library">Media library (drop or paste images to upload)</a>

<table class="blueTable">
    <thead>
        <tr>
            <th></th>
            <th>Name</th>
            <th>Category</th>
            <th>Path</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @{
            if (Model != null)
            {
                foreach (var item in Model.OrderBy(s => s.Category))
                {
                    var imgPath = "/images/" + item.Category + "/" + item.Name;
                <tr>
                    <td style="width: 72px; text-align: center;">@if ((item.ContentType ?? "").StartsWith("image/")) {<a target="_blank" href="@imgPath"><img src="@imgPath" alt="" loading="lazy" style="max-width: 64px; max-height: 40px;" /></a>}</td>
                    <td><a target="_blank" href="@imgPath">@item.Name</a></td>
                    <td>@item.Category</td>
                    <td><input type="text" style="width:90%" value="@imgPath" /></td>
                    <td><a href="@Url.Action("Update", "Upload", new { id = item.Id })">Edit</a> - <a href="#" onclick="removeUpload(@item.Id)">Remove</a></td>
                </tr>
                }
            }
            else
            {
                <tr>
                    <td>No uploads</td>
                    <td></td>
                    <td></td>
                </tr>
            }

        }
    </tbody>
</table>

@section scripts {
    <script>
    function removeUpload(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.value) {
                    window.location = "@Url.Action("Remove")/" + id;
                }
            })
        }
    </script>
    <script src="~/housekeeping/js/media-library.js" asp-append-version="true"></script>
    <script>
        document.getElementById('open-media-library').addEventListener('click', function (e) {
            e.preventDefault();
            HabboMedia.open({ title: 'Media library', onSelect: function (item) { window.open(item.url.replace(/\?v=\d+$/, ''), '_blank'); } });
            // Uploads made in the library show up in this list after a reload.
            var overlay = document.querySelector('.hm-overlay');
            new MutationObserver(function (changes, observer) {
                if (!document.body.contains(overlay)) { observer.disconnect(); location.reload(); }
            }).observe(document.body, { childList: true });
        });
    </script>
}
