@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@model KeplerCMS.Areas.MyHabbo.Models.ItemViewModel;


<div class="widget-corner" id="widget-@(Model.Item.Id)-handle">
    <div class="widget-headline">
        <h3>
            @{
                if (Model.EnableEditing)
                {
                    <img src="~/c_images/myhabbo/icon_edit.gif" width="19" height="18" class="edit-button" id="widget-@Model.Item.Id-edit">
                    <script language="JavaScript" type="text/javascript">
                                        Event.observe("widget-@Model.Item.Id-edit", "click", function (e) { openEditMenu(e, @Model.Item.Id, "widget", "widget-@Model.Item.Id-edit"); }, false);
                    </script>
                }
            }
            <span class="header-left">&nbsp;</span><span class="header-middle">@DbRes.T("highscores", "habbohome")</span><span class="header-right">&nbsp;</span>
        </h3>
    </div>
</div>
<div class="widget-body">
    <div class="widget-content">
        <table>
            <tbody>
                @{
                    // Each game the owner has points in; "no highscores" only when there are none at all.
                    var games = new[]
                    {
                        (Name: "Battle Ball", Link: "/games/battle_ball/", Points: Model.WidgetData.User.BattleballPoints),
                        (Name: "Snow Storm", Link: "/games/snowstorm/", Points: Model.WidgetData.User.SnowStormPoints),
                        (Name: "Wobble Squabble", Link: (string)null, Points: Model.WidgetData.WobbleSquabblePoints),
                    }.Where(g => g.Points > 0).ToList();

                    foreach (var game in games)
                    {
                        <tr colspan="2">
                            <th>@if (game.Link != null) { <a href="@game.Link">@game.Name</a> } else { @game.Name }</th>
                        </tr>
                        <tr>
                            <td>@DbRes.T("totalscore", "habbohome")</td>
                            <td>@game.Points</td>
                        </tr>
                    }
                    if (games.Count == 0)
                    {
                        <tr>
                            <td>@DbRes.T("nohighscores", "habbohome")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <div class="clear"></div>
    </div>
</div>