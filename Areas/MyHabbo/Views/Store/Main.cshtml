@model KeplerCMS.Areas.MyHabbo.Models.StoreViewModel
@{
    Layout = null;
}
@* The store for one item type (StoreController.Main), shown in the inventory dialog's #webstore-content. *@
<div id="webstore-categories">
    <ul class="purchase-subcategory-list">
        @foreach (var category in Model.Categories)
        {
            <li id="category-@category.Id-@Model.Type"><div>@category.Name</div></li>
        }
    </ul>
</div>
<div id="webstore-content-container" class="@Model.Type">
    <partial name="~/Areas/MyHabbo/Views/Store/Items.cshtml" model="Model.Items" />
</div>
<div class="clear"></div>
<div>
    <a href="#" id="webstore-close" class="toolbutton"><span>@DbRes.T("close", "habbohome")</span></a>
    <a href="#" id="load-inventory" class="colorlink" style="margin: 0; margin-top: 4px"><span>@DbRes.T("store_open_inventory", "habbohome") <span id="webstore-inventory-new"></span></span></a>
</div>
