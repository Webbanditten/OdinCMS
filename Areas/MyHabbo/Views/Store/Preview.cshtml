@model KeplerCMS.Areas.MyHabbo.Models.CatalogItem
@{
    Layout = null;
    var userData = (KeplerCMS.Data.Models.Users)ViewData["user"];
}
<div id="webstore-preview-box"></div>
<div style="width: 110px; float: right;">
    <h4 title="">@Model.Definition.Name</h4>
    <div id="webstore-preview-price">
        @DbRes.T("store_price", "habbohome"):<br /><b>@Model.Details.Price @DbRes.T("store_coins", "habbohome")</b>
    </div>
    <div id="webstore-preview-purse">
        @DbRes.T("store_you_have", "habbohome"):<br /><b>@(userData?.Credits ?? 0) @DbRes.T("store_coins", "habbohome")</b><br />
        <a href="/credits" target="_blank">@DbRes.T("store_getcredits", "habbohome")</a>
    </div>
    <div id="webstore-preview-purchase">
        <a href="#" class="colorlink orange last" id="webstore-purchase"><span>@DbRes.T("store_purchase", "habbohome")</span></a>
    </div>
    <span id="webstore-preview-bg-text" style="display: none">@DbRes.T("preview", "habbohome")</span>
</div>
